# Copy to .env.local (or run `vercel env pull`). Never commit real values.

# Prisma Postgres (set automatically by the Vercel Marketplace integration)
DATABASE_URL=

# Resend (set by the Vercel integration; domain breakinghundred.org must be verified)
RESEND_API_KEY=
EMAIL_FROM="Breaking Hundred <circle@breakinghundred.org>"
EMAIL_REPLY_TO=admin@breakinghundred.org

# Team inboxes for alerts A1–A4
ALERT_EMAIL=admin@breakinghundred.org
MODERATOR_EMAIL=
ACADEMY_DIRECTOR_EMAIL=

# Stripe (test keys until go-live)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=            # the recurring £299 / 12 months Price

# Mighty Networks Admin API (leave blank to add spaces by hand from /admin)
MN_API_KEY=
MN_NETWORK_ID=
MN_WEBHOOK_SECRET=          # the Authorization key you set on the Mighty webhook
MN_START_HERE_SPACE_ID=
MN_PRIVATE_SPACE_IDS=       # comma list: Academy,Library,Community,Monthly Live,Partner Directory
MN_ACADEMY_SPACE_ID=

# Site + secrets (generate with: openssl rand -base64 32)
SITE_URL=https://breakinghundred.org
LINK_SECRET=
CRON_SECRET=
ADMIN_PASSWORD=
